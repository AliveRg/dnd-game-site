# ===== Скопируй в .env для локальной разработки. В Timeweb App Platform эти же переменные задаются в "Переменные" =====

# Адрес сайта (без слеша в конце). Пока домена нет — технический адрес из App Platform (https://xxxx.twc1.net)
NUXT_PUBLIC_SITE_URL=https://example.ru
NUXT_PUBLIC_SITE_NAME=Хижина Всякой Всячины
# Город для SEO-заголовков и разметки
NUXT_PUBLIC_CITY_IN=в Белгороде
NUXT_PUBLIC_CITY=Белгород
# false = сайт закрыт от поисковиков (пока живёт на техническом домене Timeweb). Купили домен → true
NUXT_PUBLIC_INDEXABLE=false

# Яндекс Метрика — номер счётчика (только цифры). Пусто = метрика выключена
NUXT_PUBLIC_YANDEX_METRIKA_ID=

# ---- PostgreSQL (Timeweb DBaaS) ----
# Подключаемся по домену БД (нужен для проверки SSL-сертификата). Спецсимволы в пароле — URL-encoded (# → %23 и т.д.)
NUXT_DATABASE_URL=postgresql://gen_user:ПАРОЛЬ_URL_ENCODED@bfb7647d4372681f5a2832e4.twc1.net:5432/default_db
# true — если в панели БД включён SSL
NUXT_DB_SSL=true

# ---- Почта (заявки) ----
# Яндекс 360: smtp.yandex.ru / 465 / пароль приложения
NUXT_SMTP_HOST=smtp.yandex.ru
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=bot@example.ru
NUXT_SMTP_PASS=
NUXT_MAIL_FROM="Хижина <bot@example.ru>"
# Куда приходят заявки (можно несколько через запятую)
NUXT_MAIL_TO=owner@example.ru

# ---- S3 (Timeweb Object Storage) ----
NUXT_S3_ENDPOINT=https://s3.twcstorage.ru
NUXT_S3_REGION=ru-1
NUXT_S3_BUCKET=703eb6ea-20a6-49fe-a4ef-efb3c58fc626
NUXT_S3_ACCESS_KEY=
NUXT_S3_SECRET_KEY=

# ---- Админка /dragons ----
NUXT_ADMIN_LOGIN=
NUXT_ADMIN_PASSWORD=
# Любая случайная строка 32+ символа (шифрует cookie сессии)
NUXT_SESSION_PASSWORD=

# ---- Только для локального скрипта SEO (на сервер НЕ нужно) ----
WORDSTAT_API_KEY=
WORDSTAT_FOLDER_ID=
# 4 = Белгород (как в wordstat.yandex.ru/?region=4), 225 = вся Россия
WORDSTAT_REGIONS=4
